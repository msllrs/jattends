<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks all outgoing Apple events without this —
	     denied instantly, no Automation consent prompt ever shown. Needed
	     to focus Ghostty splits and for the System Events fallbacks. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
